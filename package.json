{
  "name": "joan-kitchen-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:blueprint && vite",
    "build": "npm run build:blueprint && tsc -b && vite build",
    "preview": "vite preview",
